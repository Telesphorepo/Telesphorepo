# Every text file is stored and checked out with LF, whatever core.autocrlf says (Git for Windows
# sets it to true system-wide). Without this, a Windows checkout writes CRLF, and an edit of such a
# file commits CRLF once autocrlf is off.
* text=auto eol=lf

# The server embeds install.sh and serves it to sh, so it must keep LF endings on a Windows checkout.
*.sh text eol=lf

# The migration checksums and the generated queries must not depend on the checkout's line ends.
*.sql text eol=lf

# Podman reads .dockerignore with its line ends: a CR ends every pattern, and then none matches.
.dockerignore text eol=lf
